# Copy to .env.local for local development (never commit the real file).
# All of these have working defaults baked into src/server/config/env.js
# matching what was previously hardcoded, so nothing here is required to
# run the app -- set them to point at real infrastructure per environment.

# Internal backend services (server-only, never exposed to the browser)
BACKEND_API_BASE_URL=http://api.test/api
BACKEND_HEARTBEAT_BASE_URL=http://heartbeat.test/heartbeat
BACKEND_CONFIRMATION_BASE_URL=http://confirmation.test
BACKEND_GENERATOR_BASE_URL=http://generator.test/wallet

# External services
ADDRESS_SERVICE_BASE_URL=https://ethereum.counter.co.ke
ORDER_SERVICE_BASE_URL=https://api.counter.co.ke
BINANCE_BASE_URL=https://data-api.binance.vision

# Secret -- Moralis API key. Do not prefix with NEXT_PUBLIC_.
moralis_api_key=
