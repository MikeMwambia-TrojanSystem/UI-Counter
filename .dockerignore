# Dependencies (will be installed inside the container)
node_modules
.yarn/cache
.yarn/unplugged

# Next.js build output (will be generated during build)
.next
out

# Version control
.git
.gitignore
.gitattributes

# Environment files (use build args or runtime ENV instead)
.env
.env.*
!.env.example   # optionally keep a template

# IDE and OS junk
.idea
.vscode
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# Logs and temporary files
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Docker related
Dockerfile
.dockerignore

# CI/CD and testing
.github
.gitlab
.azure
.husky
.vscode
coverage
.nyc_output
.cache
.vercel
*.test.js
*.spec.js
cypress/
playwright/

# Local development files
*.local
*.development
*.production

# Documentation, readme, etc. (optional, but not needed for build)
README.md
LICENSE
CHANGELOG.md
CONTRIBUTING.md

# Other large or unnecessary folders
public/static/fonts   # if large and not needed during build (but can be kept)
assets
videos
audio