# Logs
logs
*.log
npm-debug.log*

# Runtime data
pids
*.pid
*.seed

# Directory for instrumented libs generated by jscoverage/JSCover
lib-cov

# Coverage directory used by tools like istanbul
coverage

# nyc test coverage
.nyc_output

# Grunt intermediate storage (http://gruntjs.com/creating-plugins#storing-task-files)
.grunt

# node-waf configuration
.lock-wscript

# Compiled binary addons (http://nodejs.org/api/addons.html)
build/Release

# Dependency directories
node_modules
jspm_packages

# Optional npm cache directory
.npm

# Optional REPL history
.node_repl_history
.next

# Env -- was just `.env`, which does NOT match Next.js's own
# .env.local / .env.development.local / .env.production.local
# convention. A dev following Next's own docs for local secrets
# would not have been protected by the old pattern.
.env
.env*.local
.env.local
.env.development.local
.env.test.local
.env.production.local

# Yarn 
.yarn/*
/yarn/*

# Keys
*.pub